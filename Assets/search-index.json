a-kalakali-thesis.html","y":"ಪುಸ್ತಕ","s":"ಜಿ. ವಿ. ಚೇತನ್"},{"t":"ಬಸವಣ್ಣ ಮತ್ತು ಸರ್ವಜ್ಞರ ವಚನಗಳಲ್ಲಿ ಸಾಮಾಜಿಕ ಪ್ರಜ್ಞೆ","u":"basavanna-sarvajna-vachana-samajika-prajne-thesis.html","y":"ಪುಸ್ತಕ","s":"ಜಿ. ಪ್ರಸಾದಮೂರ್ತಿ"},{"t":"ಬಿ.ಎಂ.ಶ್ರೀ ಅವರ ಇಂಗ್ಲಿಷ್ ಗೀತಗಳು: ಮೂಲ ಆಂಗ್ಲ ಕವನಗಳು — ಒಂದು ತೌಲನಿಕ ಅಧ್ಯಯನ","u":"bm-shri-english-geetagalu-thesis.html","y":"ಪುಸ್ತಕ","s":"ಗಂಗಾಂಬಿಕೆ ಎಸ್."},{"t":"ಚೋಮನ ದುಡಿ ಮತ್ತು ಭಾರತೀಪುರ ಕಾದಂಬರಿಗಳು: ಜಾತಿ ಮತ್ತು ವರ್ಗ ಸಂಘರ್ಷ","u":"chomana-dudi-bharathipura-thesis.html","y":"ಪುಸ್ತಕ","s":"ಮಂಜುಳಾ ಎಚ್. ಎಲ್."},{"t":"ಮಧ್ಯಕಾಲೀನ ಕರ್ನಾಟಕದಲ್ಲಿ ಕುಶಲಕರ್ಮಿಗಳ ಒಂದು ಸಾಮಾಜಿಕ ಮತ್ತು ಚಾರಿತ್ರಿಕ ಅಧ್ಯಯನ","u":"madhyakaleena-karnataka-kushalakarmigalu-thesis.html","y":"ಪುಸ್ತಕ","s":"ಸಿದ್ಧಲಿಂಗಮ್ಮ ಬಿ. ಜಿ."},{"t":"ಡಾ. ವಿ.ಜಿ.ಯವರ ಮಂಕುತಿಮ್ಮನ ಕಗ್ಗ — ಒಂದು ಅಧ್ಯಯನ","u":"mankutimmana-kagga-adhyayana-thesis.html","y":"ಪುಸ್ತಕ","s":"ವೀಣಾ ಎಚ್. ಎಸ್."},{"t":"ಮೈಸೂರು ಜಿಲ್ಲೆಯ ಶಾಸನಗಳ ಸಾಂಸ್ಕೃತಿಕ ಅಧ್ಯಯನ","u":"mysore-jille-shasanagalu-thesis.html","y":"ಪುಸ್ತಕ","s":"ಮಂಜುಶ್ರೀ ಎಸ್. ಪಿ."},{"t":"ಪಂಪ ರಾಮಾಯಣ ಹಾಗೂ ತೊರವೆ ರಾಮಾಯಣಗಳು: ತೌಲನಿಕ ಅಧ್ಯಯನ","u":"pampa-ramayana-torave-ramayana-thesis.html","y":"ಪುಸ್ತಕ","s":"ಲಕ್ಷ್ಮೀ ಮೋರೆ"},{"t":"ಗ್ರಂಥಾಲಯ Library","u":"library.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಅವಿಜ್ಞಾನಿ ಗ್ರಂಥಾಲಯ — ಉಚಿತ ಕನ್ನಡ ಮತ್ತು ಇಂಗ್ಲಿಷ್ ಪುಸ್ತಕಗಳು. ಇಲ್ಲಿರುವ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳು public domain (ಲೇಖಕರು…"},{"t":"ಅನುವಾದ ಕವನಗಳು Translated Poems","u":"library-anuvada-kavanagalu.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಇಂಗ್ಲಿಷ್ ಮತ್ತು ಸಂಸ್ಕೃತ ಕವನಗಳ ಕನ್ನಡ ಅನುವಾದಗಳು — ಬಿ.ಎಂ.ಶ್ರೀಯವರ ಇಂಗ್ಲಿಷ್ ಗೀತಗಳು ಮತ್ತು ಬಸವಪ್ಪ ಶಾಸ್ತ್ರಿಯವರ…"},{"t":"ಭಕ್ತಿ Devotional","u":"library-bhakti.html","y":"ಗ್ರಂಥಾಲಯ","s":"ವಚನಗಳು ಮತ್ತು ದಾಸ ಸಾಹಿತ್ಯ — ಬಸವಣ್ಣ, ಅಲ್ಲಮ, ಕನಕದಾಸ ಮತ್ತು ಪುರಂದರದಾಸರ ಕೃತಿಗಳು."},{"t":"ಇಂಗ್ಲಿಷ್ ಕವನಗಳು English Poetry","u":"library-english-poetry.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಇಂಗ್ಲಿಷ್ ಕವನಗಳು — ಟ್ಯಾಗೋರ್, ಗಿಬ್ರಾನ್, ವರ್ಡ್ಸ್‌ವರ್ತ್, ಶೆಲ್ಲಿ, ಕೀಟ್ಸ್, ಟೆನ್ನಿಸನ್ ಮೊದಲಾದವರ ಕೃತಿಗಳು. ಎಲ್ಲಾ…"},{"t":"ಇತಿಹಾಸ History","u":"library-itihasa.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕರ್ನಾಟಕದ ಇತಿಹಾಸ ಮತ್ತು ಕನ್ನಡ ಸಾಹಿತ್ಯ ಚರಿತ್ರೆಯ ಗ್ರಂಥಗಳು."},{"t":"ಕಾದಂಬರಿ Novels","u":"library-kadambari.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕನ್ನಡ ಕಾದಂಬರಿಗಳು — ಮೊದಲ ಆಧುನಿಕ ಕಾದಂಬರಿ ಇಂದಿರಾಬಾಯಿಯಿಂದ."},{"t":"ಕಥೆಗಳು Stories","u":"library-kathegalu.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕನ್ನಡ ಕಥೆಗಳು — ಪಂಚತಂತ್ರ, ನೀತಿ ಕಥೆಗಳು ಮತ್ತು 19ನೇ ಶತಮಾನದ ಕಥಾ ಸಂಗ್ರಹಗಳು."},{"t":"ಕವನ ಸಂಕಲನ Poetry Collections","u":"library-kavana-sankalana.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕವನ ಸಂಕಲನಗಳು — ಸರ್ವಜ್ಞನ ತ್ರಿಪದಿಗಳು ಮೊದಲಾದವು."},{"t":"ಕವನ Poems","u":"library-kavana.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕನ್ನಡ ಕವನಗಳು — ಗೋವಿಂದ ಪೈ ಅವರ ಪ್ರಸಿದ್ಧ ಕವನ ಸಂಗ್ರಹಗಳು: ಗಿಳಿವಿಂಡು, ಗೋಲ್ಗೊಥಾ ಮತ್ತು ವೈಶಾಖಿ."},{"t":"ಲೇಖನ Essays","u":"library-lekhana.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕನ್ನಡ ಲೇಖನಗಳು ಮತ್ತು ಉಪನ್ಯಾಸಗಳು — ಗೋವಿಂದ ಪೈ ಅವರ ಮೂರು ಉಪನ್ಯಾಸಗಳು."},{"t":"ಮಹಾಕಾವ್ಯ Epics","u":"library-mahakavya.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕನ್ನಡದ ಮಹಾಕಾವ್ಯಗಳು — ಪಂಪನಿಂದ ಕುಮಾರವ್ಯಾಸನವರೆಗೆ. ಎಲ್ಲಾ ಪುಸ್ತಕಗಳು public domain — PDF ಉಚಿತವಾಗಿ ಓದಿ."},{"t":"ನಾಟಕ Plays","u":"library-nataka.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕನ್ನಡ ನಾಟಕಗಳು — ಎಂ. ಎನ್. ಕಾಮತ್ ಅವರ ಏಕಾಂಕಗಳು: ಸದ್ರಿ ಸುಬ್ಬ ಮತ್ತು ಶಿಕ್ಷಣ ಪರೀಕ್ಷೆ."},{"t":"ನೀತಿ ಕಥೆಗಳು Moral Stories","u":"library-neeti-kathegalu.html","y":"ಗ್ರಂಥಾಲಯ","s":"ನೀತಿ ಕಥೆಗಳು — 1864ರ ಕಥಾ ಮಂಜರಿ."},{"t":"ನಿಘಂಟು Dictionaries","u":"library-nighantu.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕನ್ನಡ ನಿಘಂಟುಗಳು — ಕಿಟ್ಟೆಲ್ ನಿಘಂಟು."},{"t":"ಪಂಚತಂತ್ರ ಕಥೆಗಳು Panchatantra Stories","u":"library-panchatantra-kathegalu.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಪಂಚತಂತ್ರ ಕಥೆಗಳು ಕನ್ನಡದಲ್ಲಿ — ತಾಳೆಗರಿ ಹಸ್ತಪ್ರತಿ ಮತ್ತು 1868ರ ಕಥಾ ಸಂಗ್ರಹ."},{"t":"ಶಾಸ್ತ್ರ Grammar & Poetics","u":"library-shastra.html","y":"ಗ್ರಂಥಾಲಯ","s":"ವ್ಯಾಕರಣ, ಛಂದಸ್ಸು ಮತ್ತು ಅಲಂಕಾರಶಾಸ್ತ್ರದ ಮೂಲಗ್ರಂಥಗಳು."},{"t":"ಥೀಸಿಸ್ Theses","u":"library-thesis.html","y":"ಗ್ರಂಥಾಲಯ","s":"ಕನ್ನಡ ಸಾಹಿತ್ಯದ ಪಿಎಚ್‌ಡಿ / ಎಂ.ಫಿಲ್ ಪ್ರಬಂಧಗಳು — ಶೋಧಗಂಗಾದ ಮುಕ್ತ ಪ್ರವೇಶ (open access) ಪ್ರಬಂಧಗಳು. ಪ್ರಬಂಧಗಳನ್ನು ಈ…"},{"t":"ಅವಿಜ್ಞಾನಿ ಯಾರು?","u":"faq.html","y":"ಪ್ರಶ್ನೆ","s":"\"ಅವಿಜ್ಞಾನಿ\" ಕನ್ನಡದ ಅಪರೂಪದ ಕವಿ,ಯಾರಿಗೂ ಕಾಣದ,ಕಾಣಲೂ ಇಷ್ಟಪಡದ ಒಂದು ಜಿನ್ನ್,ಅವರ ಪುಸ್ತಕ ಅನಾಮಧೇಯ ಗೀರುಗಳು \"ಈ ಹೊತ್ತಿಗೆ…"},{"t":"ಅನಾಮಧೇಯ ಗೀರುಗಳು ಪುಸ್ತಕ ಎಲ್ಲಿ ಸಿಗುತ್ತೆ?","u":"faq.html","y":"ಪ್ರಶ್ನೆ","s":"ಅವಿಜ್ಞಾನಿ ಅವರ ಪ್ರಥಮ ಕವನ ಸಂಕಲನ ‘ಅನಾಮಧೇಯ ಗೀರುಗಳು’ Beetle Bookshop ಮತ್ತು Prajodaya (Instamojo) ನಲ್ಲಿ…"},{"t":"ಅವಿಜ್ಞಾನಿ ಅವರಿಗೆ ಸಿಕ್ಕ ಪ್ರಶಸ್ತಿಗಳು ಯಾವುವು?","u":"faq.html","y":"ಪ್ರಶ್ನೆ","s":"‘ಅನಾಮಧೇಯ ಗೀರುಗಳು’ ಸಂಕಲನಕ್ಕೆ 2024ರಲ್ಲಿ ಬೆಂಗಳೂರಿನ ಈ ಹೊತ್ತಿಗೆ ಕಾವ್ಯ ಪ್ರಶಸ್ತಿ ಸಿಕ್ಕಿದೆ — ಆಗ ಸಂಕಲನ…"},{"t":"ಈ site ನಲ್ಲಿ ಎಷ್ಟು ಕವನಗಳಿವೆ?","u":"faq.html","y":"ಪ್ರಶ್ನೆ","s":"ಈ site ನಲ್ಲಿ 37 ಸಂಗ್ರಹಗಳಲ್ಲಿ 81 ಕವನ ಪುಟಗಳಿವೆ — ದೊಡ್ಡ ಕವನಗಳು, ‘ಬದುಕಿದ ಹನಿಗಳು’ ಸಂಗ್ರಹದ 45 ಹನಿಗಳು ಮತ್ತು ‘ಬದುಕಿಗೆ…"},{"t":"ಪ್ರೇಮ ಕವನಗಳು ಎಲ್ಲಿ ಓದೋದು?","u":"faq.html","y":"ಪ್ರಶ್ನೆ","s":"ಪ್ರೇಮ ಕವನಗಳು ಪ್ರೇಮ ಕವನಗಳ ಪುಟ ದಲ್ಲಿವೆ — ‘ಅವನ ಪ್ರೀತಿ’ ಸೇರಿದಂತೆ ಪ್ರೀತಿಯ ಬಗ್ಗೆ ಬರೆದ ಕವನಗಳು ಮತ್ತು ಹನಿಗಳು ಒಂದೇ ಕಡೆ…"},{"t":"ಕವನಗಳಿಗೆ ಪ್ರತಿಕ್ರಿಯೆ ಹೇಗೆ ಬರೆಯೋದು?","u":"faq.html","y":"ಪ್ರಶ್ನೆ","s":"ಪ್ರತಿ ಕವನ ಪುಟದ ಕೆಳಗೆ ಪ್ರತಿಕ್ರಿಯೆ ಬರೆಯುವ ಜಾಗ ಇದೆ — ಉದಾಹರಣೆಗೆ ಈ ಕವನ ಪುಟ ನೋಡಿ. ಹೆಸರು ಮಾತ್ರ ಬರೆದರೆ ಸಾಕು — ಲಾಗಿನ್…"},{"t":"ಚಾಯ ಕೊಡಿಸಿ ಎಂದರೇನು?","u":"faq.html","y":"ಪ್ರಶ್ನೆ","s":"‘ಚಾಯ ಕೊಡಿಸಿ’ ಎಂದರೆ ಕವಿಗೆ ಒಂದು ಚಾಯ ಕೊಡಿಸಿ ಬೆಂಬಲಿಸುವ ಪುಟ. ಕವನಗಳು ನಿಮ್ಮ ಮನಸ್ಸಿಗೆ ತಾಕಿದರೆ, ಚಾಯ ಪುಟ ದಲ್ಲಿರುವ QR…"},{"t":"ಅವಿಜ್ಞಾನಿ ಅವರನ್ನು social media ನಲ್ಲಿ ಎಲ್ಲಿ ಹಿಂಬಾಲಿಸೋದು?","u":"faq.html","y":"ಪ್ರಶ್ನೆ","s":"Instagram ನಲ್ಲಿ @avigyani, Facebook ನಲ್ಲಿ ಅವಿಜ್ಞಾನಿ ಪುಟ, YouTube ನಲ್ಲಿ @homosep ಚಾನಲ್, X (Twitter) ನಲ್ಲಿ…"},{"t":"ಇತರರ ಕೆಲಸಗಳು ಪುಟ ಎಂದರೇನು?","u":"faq.html","y":"ಪ್ರಶ್ನೆ","s":"‘ಇತರರ ಕೆಲಸಗಳು’ ಪುಟವು ಅವಿಜ್ಞಾನಿ ಅವರ ಸ್ನೇಹಿತರ ಕವನಗಳು ಮತ್ತು ಲೇಖನಗಳಿಗಾಗಿ — ಅವರದೇ ಮಾತುಗಳಲ್ಲಿ, ಅವರದೇ ಪುಟಗಳಲ್ಲಿ.…"}]