[{"t":"ಅವಿಜ್ಞಾನಿ — ಕನ್ನಡ ಕವನಗಳು","u":"index.html","y":"ಮುಖಪುಟ","s":"ಇದು ಅವಿಜ್ಞಾನಿಯ ಕನ್ನಡ ಕವನಗಳ ಲೋಕ — ಪ್ರೇಮ ಕವನ, ಹನಿಗವನ, ನೋವಿನ ಸಾಲುಗಳು. ೪೬ ಕವನಗಳ ಪುಸ್ತಕ 'ಅನಾಮಧೇಯ ಗೀರುಗಳು' ೨೦೨೪ರ ಈ…"},{"t":"Avigyani Kannada Poet","u":"english.html","y":"ಪುಟ","s":"Avigyani (Nizam Golipadpu) — Kannada poet from Mangaluru. About the poet in English, free Kannada books PDFs…"},{"t":"☕ ಚಾಯ ಕೊಡಿಸಿ","u":"chaya.html","y":"ಪುಟ","s":"ಕವಿ ಅವಿಜ್ಞಾನಿ ಅವರ ಕನ್ನಡ ಕವನಗಳನ್ನು ಬೆಂಬಲಿಸಿ — ಒಂದು ಚಾಯದಷ್ಟು ಪ್ರೀತಿ ಕೊಡಿ. Support Kannada poet Avigyani with a…"},{"t":"ಅಚ್ಚಾಗಿದ್ದು My Book","u":"book.html","y":"ಪುಸ್ತಕ","s":"'ಅನಾಮಧೇಯ ಗೀರುಗಳು' — ಅವಿಜ್ಞಾನಿ ಅವರ ಕವನ ಸಂಕಲನ ಪುಸ್ತಕ, ಬೆಲೆ ₹108 (ಪದ ಪ್ರಕಾಶನ). Kannada poetry book Anamadheya…"},{"t":"ನಿಮ್ಮ ಕುತೂಹಲಕ್ಕೆ About Me","u":"about.html","y":"ಪುಟ","s":"ಕವಿ ಅವಿಜ್ಞಾನಿ (ನಿಜಾಮ್ ಗೋಳಿಪಡ್ಪು, ಮಂಗಳೂರು) ಅವರ ಬಗ್ಗೆ — 'ಅನಾಮಧೇಯ ಗೀರುಗಳು' ಕವನ ಸಂಕಲನದ ಲೇಖಕ, ಈ ಹೊತ್ತಿಗೆ ಕಾವ್ಯ…"},{"t":"ಕಡಿದು ಗುಡ್ಡೆ ಹಾಕಿದ್ದು Awards","u":"awards.html","y":"ಪುಟ","s":"ಅವಿಜ್ಞಾನಿ ಅವರಿಗೆ ಸಂದ ಪ್ರಶಸ್ತಿಗಳು — 2024 ಈ ಹೊತ್ತಿಗೆ ಕಾವ್ಯ ಪ್ರಶಸ್ತಿ, 2020 TRF ಯುವಕವಿ ಪ್ರಶಸ್ತಿ. Awards won by…"},{"t":"ಚೆಹರೆಗಳು Photos","u":"photos.html","y":"ಪುಟ","s":"ಅವಿಜ್ಞಾನಿ ಅವರ ಫೋಟೋಗಳು — 'ಅನಾಮಧೇಯ ಗೀರುಗಳು' ಪುಸ್ತಕ ಬಿಡುಗಡೆ ಮತ್ತು ಪ್ರಶಸ್ತಿ ಸಮಾರಂಭದ ಚಿತ್ರಗಳು (ಮಾರ್ಚ್ 2024).…"},{"t":"ಇತರರ ಕೆಲಸಗಳು Works by Friends","u":"itarara-kelasagalu.html","y":"ಪುಟ","s":"ಅವಿಜ್ಞಾನಿ ಅವರ ಸ್ನೇಹಿತರ ಕವನಗಳು ಮತ್ತು ಲೇಖನಗಳು — ಅವರ Facebook ಮತ್ತು Instagram ಲಿಂಕ್‌ಗಳೊಂದಿಗೆ. Poems and writings…"},{"t":"ಲೇಖನಗಳು Articles","u":"lekhanegalu.html","y":"ಪುಟ","s":"ಅವಿಜ್ಞಾನಿ ಅವರ ಲೇಖನಗಳು. Articles and essays by Kannada poet Avigyani."},{"t":"ಬಸವಣ್ಣನ ವಚನಗಳು","u":"basavanna-vachanagalu.html","y":"ಪುಟ","s":"ಬಸವಣ್ಣನ ಪ್ರಸಿದ್ಧ 10 ವಚನಗಳು — ಕನ್ನಡದಲ್ಲಿ ಪಠ್ಯ + ಸರಳ ಅರ್ಥ. ಉಳ್ಳವರು ಶಿವಾಲಯ ಮಾಡುವರು, ಕಳಬೇಡ ಕೊಲಬೇಡ, ದಯವಿಲ್ಲದ…"},{"t":"ಕನ್ನಡ ಕೋಟ್ಸ್ Kannada Quotes","u":"kannada-quotes.html","y":"ಪುಟ","s":"ಅವಿಜ್ಞಾನಿ ಅವರ ಕನ್ನಡ ಕೋಟ್ಸ್ — ಕನ್ನಡ ಲವ್ ಕೋಟ್ಸ್, ಕವನ ಕೋಟ್ಸ್. Kannada quotes, kannada love quotes and kannada…"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu.html","y":"ಪುಟ","s":"ಬದುಕಿದ ಹನಿಗಳು — ಅವಿಜ್ಞಾನಿಯವರ 45 ಹನಿಗವನಗಳು."},{"t":"ವಿಡಿಯೋಗಳು Videos","u":"videos.html","y":"ಪುಟ","s":"ಅವಿಜ್ಞಾನಿ ಅವರ ಕನ್ನಡ ಕವನ ವಿಡಿಯೋಗಳು — @homosep YouTube ಚಾನಲ್‌ನ ಕವನ ಶಾರ್ಟ್ಸ್. Avigyani videos and kannada kavana…"},{"t":"ಸಂಪರ್ಕ Contact","u":"contact.html","y":"ಪುಟ","s":"Contact Avigyani — email nizampj23@gmail.com for ebook orders, payments and refunds."},{"t":"ಅವನ ಪ್ರೀತಿ","u":"preeti.html","y":"ಕವನ","s":"ಅವನನ್ನು ತುಂಬಾ ಪ್ರೀತಿಸುತ್ತಾರೆ ಹಿಂದಿನಿಂದ; ಅವನಿಗದು ತೀರಾ ತಿಳಿಬಯಸದ ವಿಷಯ — ಅವನ ಪ್ರೀತಿ · ಅವಿಜ್ಞಾನಿ ಅವರ ಪ್ರೇಮ ಕನ್ನಡ…"},{"t":"ಬದುಕಿಗೆ ರಂಗು","u":"rangu.html","y":"ಕವನ","s":"ಬದುಕಿಗೆ ರಂಗು ಮೆತ್ತುವ ಈ ಉಸಾಬರಿ, ಶತಮಾನಗಳಿಂದ ನನ್ನ ಬೆನ್ನು ತೊರೆದಿಲ್ಲ. ಇನ್ನೂ ರೂಪ ಬೇಕು, ರೂಪ ಬೇಕು — ಬದುಕಿಗೆ ರಂಗು ·…"},{"t":"ಇ-ಬುಕ್ Ebook","u":"ebook.html","y":"ಇ-ಪುಸ್ತಕ","s":"ಅನಾಮಧೇಯ ಗೀರುಗಳು — ಅವಿಜ್ಞಾನಿ ಅವರ ಕವನ ಸಂಕಲನ ಇ-ಬುಕ್, ₹101. ೪೬ ಕವನಗಳು, ಬ್ರೌಸರ್‌ನಲ್ಲೇ ಓದಿ. Award-winning Kannada…"},{"t":"ಪ್ರೇಮ ಕವನಗಳು Love Poems","u":"preeti-kavanagalu.html","y":"ವಿಭಾಗ","s":"ಪ್ರೇಮದ ಬಣ್ಣ ಹಚ್ಚಿದ ಕವನಗಳು. ದಕ್ಕದ ಪ್ರೀತಿ, ನೆನಪು, ಕನಸು — ಪ್ರೀತಿಯ ಒಂದೊಂದು ಮುಖ."},{"t":"ಬದುಕಿನ ಕವನಗಳು Life Poems","u":"baduku-kavanagalu.html","y":"ವಿಭಾಗ","s":"ಬದುಕಿನ ಬಗ್ಗೆ ಬರೆದ ಕವನಗಳು. ಬದುಕು ಕಲಿಸಿದ ಪಾಠ, ಅದರ ನೋವು, ಅದರ ಸೋಜಿಗ."},{"t":"ನೋವಿನ ಕವನಗಳು Sad Poems","u":"novu-kavanagalu.html","y":"ವಿಭಾಗ","s":"ನೋವಿನ ಬಗ್ಗೆ ಬರೆದ ಕವನಗಳು. ನೋವು, ಬೇನೆ, ಕಣ್ಣೀರು — ಬದುಕಿನ ಕಹಿ ಮುಖ."},{"t":"ಸಾವಿನ ಕವನಗಳು Poems on Death","u":"savu-kavanagalu.html","y":"ವಿಭಾಗ","s":"ಸಾವಿನ ಬಗ್ಗೆ ಬರೆದ ಕವನಗಳು. ಸಾವು, ಮರಣ, ಅಂತ್ಯ — ಕವಿಯ ಕಣ್ಣಲ್ಲಿ."},{"t":"ಒಂಟಿತನದ ಕವನಗಳು Poems on Loneliness","u":"ontitana-kavanagalu.html","y":"ವಿಭಾಗ","s":"ಒಂಟಿತನದ ಬಗ್ಗೆ ಬರೆದ ಕವನಗಳು. ಒಂಟಿ ನಡಿಗೆ, ಒಂಟಿ ಬದುಕು, ಒಂಟಿ ಕನಸು."},{"t":"ಕನಸಿನ ಕವನಗಳು Dream Poems","u":"kanasu-kavanagalu.html","y":"ವಿಭಾಗ","s":"ಕನಸಿನ ಬಗ್ಗೆ ಬರೆದ ಕವನಗಳು. ಕನಸು, ನಿರೀಕ್ಷೆ, ಕಾಣದ ಬೆಳಕು."},{"t":"ಬಡತನ ಮತ್ತು ಹಸಿವಿನ ಕವನಗಳು Poems on Poverty and Hunger","u":"badatana-kavanagalu.html","y":"ವಿಭಾಗ","s":"ಬಡತನ ಮತ್ತು ಹಸಿವಿನ ಬಗ್ಗೆ ಬರೆದ ಕವನಗಳು. ಹಸಿವು, ಬಡತನ, ಬದುಕಿನ ಕಷ್ಟ."},{"t":"ತತ್ವ ಕವನಗಳು Philosophical Poems","u":"tatva-kavanagalu.html","y":"ವಿಭಾಗ","s":"ತತ್ವದ ಬಗ್ಗೆ ಬರೆದ ಕವನಗಳು. ಜೀವನ, ಜಗತ್ತು, ಮನುಷ್ಯ — ಕವಿಯ ಚಿಂತನೆ."},{"t":"ಅಮಲು ಹನಿಗಳು","u":"poem-1.html","y":"ಕವನ","s":"ಅಮಲು ಹನಿಗಳು.! / ಒಂದು ಪವಿತ್ರ"},{"t":"ನನ್ನ ಮರಣ ಶಾಸನವನ್ನು ನಾನೇ ಓದುತ್ತೇನೆಂದು","u":"poem-2.html","y":"ಕವನ","s":"ಹೇಗೆ ಹೇಳಲಿ / ನನ್ನಾತ್ಮಕ್ಕೆ ಕಫನ್ ನಾನೇ ತೊಡಿಸುವುದೆಂದು"},{"t":"ಯಾರೂ ಸುಳಿಯದ","u":"poem-3.html","y":"ಕವನ","s":"ಒಂಟಿತನಕ್ಕೆ ಜೋತು ಬೀಳುತ್ತೇನೆ / ಎದೆಬಿರಿದ ಸದ್ದು"},{"t":"ನಿನ್ನ ಬೆತ್ತಲೆ ಪಾದಗಳಿಗೊಮ್ಮೆ","u":"poem-4.html","y":"ಕವನ","s":"ನಾ ಮುತ್ತನಿಟ್ಟು ಬಿಡಬೇಕು / ಆದದ್ದಾಗಲಿ ಇಲ್ಲೇ ಪಕ್ಕದಲ್ಲಿ ತೋಳಿಗೆ ಒರಗಿ ಕೂರು ಸಣ್ಣ ಮಟ್ಟದ"},{"t":"ನನ್ನ ಸಾವಿಗೆ","u":"poem-5.html","y":"ಕವನ","s":"ನಾ ಮಾದಕತೆ ತುಂಬಿಟ್ಟಿದ್ದೇನೆ / ಬಹುವಾಗಿ"},{"t":"ಮಳೆಬೆನ್ನಿನ ಚಾಪೆಯಲ್ಲಿ","u":"poem-6.html","y":"ಕವನ","s":"ನಿದ್ದೆ ಹೊತ್ತ ಕತೆಗಳು / ಇಲ್ಲಿ ಕೇಳಿಸಬೇಡಿ"},{"t":"ಗುನುಗುತ್ತೇನೆ ಯಾವುದೋ","u":"poem-7.html","y":"ಕವನ","s":"ಹಾಡನ್ನು ಯಾವುದೇ ರಾಗವಿಲ್ಲದೇ / ಈ ಮೊದಲೂ ಇನ್ನಾರಿಗೋ ಇಷ್ಟದ ಹಾಡಾಗಿದ್ದಿರಬಹುದು ಅದು"},{"t":"ಹೃದಯ ಮಾತನಾಡುತ್ತದೆ","u":"poem-8.html","y":"ಕವನ","s":"ಶ್!.... / ಹೃದಯ ಮಾತನಾಡುತ್ತದೆ"},{"t":"ಒಂದು ದಿವ್ಯ ಮೌನ","u":"poem-9.html","y":"ಕವನ","s":"ಸೂತಕದ ಆಚೆಗಿನಂತೆ / ಆವರಿಸಿಕೊಂಡರೆ"},{"t":"ಯಾರದೋ ನೋವಿಗೆ","u":"poem-10.html","y":"ಕವನ","s":"ಇನ್ನಾರದೋ ಹಾಡಿಗೆ / ನನ್ನದೂ ಸೇರಿಸಿ"},{"t":"ಮತ್ತೆ ನಾನು","u":"poem-11.html","y":"ಕವನ","s":"ನನಗೆ ಸಿಗುವಾಗ / ಯಾವ ಸಮಾಧಾನವಿದೆ"},{"t":"ನಾನು ಹೀಗೆಯೇ","u":"poem-12.html","y":"ಕವನ","s":"ಬದುಕಿಹೋಗುತ್ತೇನೆ / ಕಾಡು ಹೂವಂತೆ"},{"t":"ಕನಸು ಸಿಕ್ಕಲಾರೆ","u":"poem-13.html","y":"ಕವನ","s":"ಕಡದ ಕೈಯೊಳಗೆ ಎಂದಿತು / ಹಾರಲು ಬಿಟ್ಟೆ"},{"t":"ಹೇಳಿದ್ದು ಕೇಳಿದ್ದೇನೆ","u":"poem-14.html","y":"ಕವನ","s":"ಅವರು / 'ಸಮಯ'"},{"t":"ಒಂದು ಹರಿತವಾದ ಬೇನೆ","u":"poem-15.html","y":"ಕವನ","s":"ತಡವಿದಷ್ಟೂ ಊನ / ದಿನಗಳೂ ಉರಿ ಮೇಲಿನ"},{"t":"ಈ ಗಿಜಿಗುಡುವ ಷಹರದ","u":"poem-16.html","y":"ಕವನ","s":"ಮೂಲೆಯಲ್ಲಿ ಏಕಾಂತವನ್ನು / ಧೇನಿಸುವ ನನ್ನ ಬಗ್ಗೆ ಯಾವೊಂದು"},{"t":"ಇದು ಮೊದಲೇನಲ್ಲ","u":"poem-17.html","y":"ಕವನ","s":"ತಿಳಿದಿದ್ದೇನೆ ಕೊನೆಯೂ / ಆಗಲಾರದು"},{"t":"ಅವ ಬಂಡೆಕಲ್ಲಿನಂತೆ","u":"poem-18.html","y":"ಕವನ","s":"ಬದುಕಿದ್ದ ಅನ್ನುತ್ತಾನೊಬ್ಬ / ಯಾವ ಮೊಳಕೆಯೂ"},{"t":"ಇಳಿದ ಕಂದೀಲ","u":"poem-19.html","y":"ಕವನ","s":"ಜೋಪಡಿಯಲ್ಲಿ / ಅಳುವ ಮಡಿಕೆ"},{"t":"#World_Poetry_Day","u":"poem-20.html","y":"ಕವನ","s":"ನನ್ನ ಸಂಜೆಗಳ ಕುರಿತು / ಕೇಳಬೇಡ"},{"t":"ನನ್ನ ಉಸಿರೂ ನಿಲ್ಲಲಿದೆ","u":"poem-21.html","y":"ಕವನ","s":"ಯಾವ ಆಸ್ಫೋಟನೆಯ / ಭೀಕರತೆಯಲ್ಲ ಅದು"},{"t":"ನೀನೊಂದು ದಕ್ಕಲಾರದ","u":"poem-22.html","y":"ಕವನ","s":"ಕವಿತೆ / ಆದರೂ ಬರೆಯುವ ಪಣ"},{"t":"ನಿನ್ನ ರಾತ್ರಿ","u":"poem-23.html","y":"ಕವನ","s":"ನಿನಗೆ ಭಯ / ಆಗುವ ಕಂಪನವನ್ನು"},{"t":"ಯಾವ ನೋವಿಗೂ","u":"poem-24.html","y":"ಕವನ","s":"ತೆಕ್ಕೆಗಳಿಲ್ಲ ನಾಜೂಕತನದ / ಲೋಕದಲ್ಲಿ ಮುಸಾಫಿರ"},{"t":"ಪ್ರೇಮವಿಲ್ಲದೇ","u":"poem-25.html","y":"ಕವನ","s":"ಇಲ್ಲೇನು ಜರುಗುವುದಿಲ್ಲ / ದ್ವೇಷವೂ ಕೂಡ"},{"t":"ಬದುಕಿಗೆ ರಂಗು","u":"poem-28.html","y":"ಕವನ","s":"ಮೆತ್ತುವ ಈ ಉಸಾಬರಿ / ಶತಮಾನಗಳಿಂದ"},{"t":"ನನ್ನನ್ನು ಕ್ಷಮಿಸಿ","u":"poem-29.html","y":"ಕವನ","s":"ಕ್ಷಮಿಸಿ ನಿಮ್ಮ ಅಂತರಾಳದಿಂದ / ನಾಭಿ ಸೀಳಿದ ಕರುಣಾಜನಕತೆಯೊಂದು"},{"t":"ದಣಿದವನಿದ್ದ ಅವ","u":"poem-30.html","y":"ಕವನ","s":"ಅದೇನನ್ನೋ ಕಳೆದುಕೊಂಡವನಂತೆ / ಹುಡುಕು ಹತ್ತಿಸಿಕೊಂಡ"},{"t":"ಇಲ್ಲಿ ನೋವಿದೆ ಸಾವಿದೆ","u":"poem-31.html","y":"ಕವನ","s":"ಅದೇ ಸೂತಕದ ಸಂತೆ / ಕಡ್ಡೆ ಮಾರಿ"},{"t":"ನೀನು ಸಾವಧಾನಿಸು","u":"poem-32.html","y":"ಕವನ","s":"ಈ ಉರಿಯ ಉಜ್ಜಿಕೊಂಡ / ರಾತ್ರಿಯಲ್ಲಿ ನನ್ನದೆಯ"},{"t":"ಎಲ್ಲಾ ಬೀದಿ","u":"poem-33.html","y":"ಕವನ","s":"ದೀಪಗಳೂ ಆರಿಯೇ ಇರಲಿ / ಬೆಳಕಲ್ಲಿದೆ ಉರಿಯುತ್ತಿದ್ದರೂ"},{"t":"ನಾ ಬೊಗಸೆಯಾಗುತ್ತೇನೆ","u":"poem-34.html","y":"ಕವನ","s":"ನಿನ್ನ ಕಣ್ಣೀರಿಗಲ್ಲ / ತಥಾ ನನ್ನಿಂದ"},{"t":"ನನ್ನ ನೋವು ನನ್ನದಲ್ಲ","u":"poem-35.html","y":"ಕವನ","s":"ಎಂದು ಕೊಂಡಾಕ್ಷಣ / ಬೊಗಸೆ ಕೈಯಾಗಿಸಿಬೇಡುವ"},{"t":"ಒಂದು ಸುಂದರ ಸಂಜೆ","u":"poem-36.html","y":"ಕವನ","s":"ನಾ ಸಾಯಬೇಕು / ಆ ಪ್ರಶಾಂತತೆಯ ಬೆನ್ನಲ್ಲಿ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-1.html","y":"ಹನಿಗವನ","s":"ಸತಾಯಿಸುವ ಸಾವಿಗೇನು / ಗೊತ್ತು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-2.html","y":"ಹನಿಗವನ","s":"ದಿನಾ ಸಾಯುವುದನ್ನು / ಕಲಿತಿದ್ದೇನೆ ಬದುಕೇ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-3.html","y":"ಹನಿಗವನ","s":"ಡೊಂಕಾಗಿ ನಡೆದಾಗ / ಮುಸಿ ನಗುವ ಸಂತೆಯವರು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-4.html","y":"ಹನಿಗವನ","s":"ಬದುಕು ಬಾಗಲು / ಕಲಿಸಿತು ಬಾಗಿದೆ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-5.html","y":"ಹನಿಗವನ","s":"ನಾ ಗಳಿಸಿಕೊಂಡಿದ್ದೆಲ್ಲ / ಗಾಳಿಮಾತು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-6.html","y":"ಹನಿಗವನ","s":"ಬದುಕು ಮಗುವಿನ / ಖುಷಿಯಾಗಲಿಲ್ಲ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-7.html","y":"ಹನಿಗವನ","s":"ನನ್ನ ದಿನಮಾನದ / ಗಡಿಯಾರ ಬಿಕ್ಕುವುದನ್ನಷ್ಟೇ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-8.html","y":"ಹನಿಗವನ","s":"ಅಂಗೈಯಗಲ / ನಸೀಬಿನವನಲ್ಲಿ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-9.html","y":"ಹನಿಗವನ","s":"ದಲ್ಲಾಳಿತನದ / ಜಗತ್ತಿದು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-10.html","y":"ಹನಿಗವನ","s":"ನನ್ನ ನತದೃಷ್ಟತೆಯಲ್ಲಿ / ನೀನಷ್ಟೇಯಲ್ಲ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-11.html","y":"ಹನಿಗವನ","s":"ಸುಡುವ / ಬದುಕ ಮೇಲೆ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-12.html","y":"ಹನಿಗವನ","s":"ಬದುಕ ಬಗ್ಗೆ / ರಮ್ಯವಾಗಿ ಬರೆದವ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-13.html","y":"ಹನಿಗವನ","s":"ನನ್ನ ನೋವ ಕುರಿತು / ಕೇಳಬೇಡ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-14.html","y":"ಹನಿಗವನ","s":"ನೀ ನೀನಾಗಿಯೇ ಇರು / 'ಅವಿ,"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-15.html","y":"ಹನಿಗವನ","s":"ಬದುಕಿಗಾಗಿ / ಬಾಗುತ್ತೇನೆ ಬಹಳವೇ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-16.html","y":"ಹನಿಗವನ","s":"ಊತ ಕಾಲಿನದ್ದೇ / ಆಗಿತ್ತು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-17.html","y":"ಹನಿಗವನ","s":"ನಿನ್ನ ಬಿರಿದ ತೇಗಿಗಿಂತ / ನನ್ನ ಹಸಿವ ಕೂಗು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-18.html","y":"ಹನಿಗವನ","s":"ನಿನ್ನ ಹಿಸಾಬಿನ / ಅಳತೆಗೋಲು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-19.html","y":"ಹನಿಗವನ","s":"ಸೋಲಿನ ಕುರಿತು ಪರಾಧಿ / ಇಲ್ಲ ನನಗೆ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-20.html","y":"ಹನಿಗವನ","s":"ಧ್ಯಾನಸ್ಥ ಹೂವಿನ ಮೌನ / ಮರಣ ಮೃದುಂಗವಾಗಿದೆ ಈಗ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-21.html","y":"ಹನಿಗವನ","s":"ನನ್ನ ಪರಿತಾಪಗಳು / ನಿನ್ನ ಸಂತಾಪದ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-22.html","y":"ಹನಿಗವನ","s":"ನನ್ನ ಕಡದ ಕೈ / ಕೊಳೆಯಾಗಿ ಕಾಣಬಹುದು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-23.html","y":"ಹನಿಗವನ","s":"ಪ್ರೀತಿ ಪ್ರೇಮ / ಕಾಮದ ಕುರಿತು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-24.html","y":"ಹನಿಗವನ","s":"ಬೆರಳು ಚಾಚದಿರಿ / ನನ್ನತ್ತ ಕವಿಯೆಂದು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-25.html","y":"ಹನಿಗವನ","s":"ರಾತ್ರಿಗಳೆಷ್ಟೋ ಜಾರಿ ಹೋದವು / ಕನಸ ದೀಪ ಆರದಿರಲೆಂಬ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-26.html","y":"ಹನಿಗವನ","s":"ನನ್ನ ಹಾಡಿಯ / ಕತ್ತಲ ಹಾಡು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-27.html","y":"ಹನಿಗವನ","s":"ನಿನ್ನ ಸನ್ಮಾನಗಳ / ಬೆಂಕಿ ನನ್ನ ಸುಡದಿರಲಿ"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-28.html","y":"ಹನಿಗವನ","s":"ಆಟಿಕೆಗಳಿದ್ದವು / ನಿನ್ನವೇ ಬಹಳಷ್ಟು"},{"t":"ಬದುಕಿದ ಹನಿಗಳು","u":"hanigalu-29.html","y":"ಹನಿಗವನ","s":"ನವಿಲು ನೀನು / ಗರಿಬಿಚ್ಚು ಯಥೇಚ್ಛವಾಗಿ"},{"t":"ಬದುಕಿದ ಹನಿಗಳ